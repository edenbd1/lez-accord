class Accord
{
    // Every read is asynchronous: the view passes a token of its own making
    // and the answer arrives as `answered(token, json)` with the same token.
    // Each slot returns "" at once, or "error: …" when the request was refused.
    //
    // A multisig by id (text of at most 32 bytes, or 64 hex digits).
    // json: the configuration as decoded from chain, or {ok: false, error}.
    SLOT(QString loadMultisig(QString token, QString multisigId))
    // An approval package from a file path or pasted JSON: decoded from its
    // action bytes, its digest recomputed, its queued record read from chain.
    SLOT(QString loadPackage(QString token, QString multisigId, QString pathOrJson))
    // Saved under the Basecamp user directory; an empty value restores the default.
    SLOT(QString saveSettings(QString rpc, QString program))

    // ── The room: a Logos Chat group conversation per configuration epoch ──
    // Bring the chat module up (once per session). chatState follows the
    // delivery node: "initialising", "online", "error".
    SLOT(QString chatStart())
    // Create the room for a multisig's epoch; json: {ok, convo_id} or {ok: false, error}.
    SLOT(QString roomCreate(QString token, QString name))
    // Invite a member's chat address (their address is shown in their own app).
    SLOT(QString roomAdd(QString convoId, QString address))
    // Post a line of deliberation, or an approval package (a path or its JSON).
    SLOT(QString roomPost(QString convoId, QString textOrPackage))
    // {convo_id, name, kind, members: [{address, pending}]} for every room held.
    SLOT(QString roomList(QString token))

    PROP(QString chatState="off" READONLY)
    PROP(QString chatAddress="" READONLY)
    // A message in any room: the view decodes it if it is an approval package.
    SIGNAL(roomMessage(QString convoId, QString sender, QString content, bool fromSelf))

    PROP(QString appVersion="" READONLY)
    PROP(QString rpc="" READONLY)
    PROP(QString program="" READONLY)
    SIGNAL(answered(QString token, QString json))
}
